{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vouchify",
  "version": "0.3.44",
  "identifier": "com.vouchify.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vouchify | 付款凭证",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxRTJFRDZGNEY5OTEyNzQKUldSMEVwbFBiKzNpVVVCZEIranFFWUdJWVN3c0U5eUJrbzFHZUFxT21EVTlYT3BQZ1NwREJMcWkK",
      "endpoints": [
        "https://github.com/OmarKrypton/Payment_App/releases/latest/download/latest.json"
      ]
    }
  }
}
